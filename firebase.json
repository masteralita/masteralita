{
  "firestore": {
    "database": "glaxywardb",
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/hosting",
    "redirects": [
      {
        "source": "/",
        "destination": "/play/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      }
    ],
    "trailingSlash": true
  }
}
